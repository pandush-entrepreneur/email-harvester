{% extends "base.html" %}{% block content %}<section class="hero"><div><div class="eyebrow">HARVESTER</div><h1>Every list. One clean queue.</h1><p>Find, validate, and monitor email enrichment from upload to send-ready CSV.</p></div><a href="{{ url_for('new_job') }}" class="button">+ Upload a list</a></section><section class="metric-grid"><article><span>Daily capacity</span><strong>{{ "{:,}".format(daily_cap) }}</strong><small>MailTester requests</small></article><article><span>MailTester key</span><strong>{{ 'Available' if key.available else 'In use' }}</strong><small>{{ 'Ready for work' if key.available else key.workflow + ': ' + key.name }}</small></article><article><span>Send safety</span><strong>Verified only</strong><small>Catch-all guesses excluded</small></article></section><section class="section-head"><div><h2>Lists</h2><p>Live progress refreshes automatically.</p></div></section><div id="jobs" class="jobs">{% for job in jobs %}<a class="job-card" href="{{ url_for('job_detail', job_id=job.id) }}" data-job="{{ job.id }}"><div class="job-top"><div><h3>{{ job.name }}</h3><span class="muted">{{ job.created_at[:10] }}</span></div><span class="status {{ job.state }}">{{ job.state.replace('_',' ') }}</span></div><div class="progress"><i style="width:{{ job.percent }}%"></i></div><div class="job-stats"><div><strong data-k="percent">{{ job.percent }}%</strong><span>progress</span></div><div><strong data-k="verified">{{ "{:,}".format(job.verified) }}</strong><span>verified</span></div><div><strong data-k="results">{{ "{:,}".format(job.results) }}</strong><span>requests</span></div><div><strong data-k="domains">{{ "{:,}".format(job.domains) }}</strong><span>domains</span></div></div></a>{% else %}<div class="empty"><h3>No lists yet</h3><p>Upload your first CSV to begin.</p></div>{% endfor %}</div>{% endblock %}{% block scripts %}<script>setInterval(async()=>{try{const jobs=await(await fetch('/api/jobs')).json();for(const j of jobs){const c=document.querySelector(`[data-job="${j.id}"]`);if(!c)continue;c.querySelector('.status').textContent=j.state.replaceAll('_',' ');c.querySelector('.progress i').style.width=j.percent+'%';for(const k of ['verified','results','domains'])c.querySelector(`[data-k="${k}"]`).textContent=j[k].toLocaleString();c.querySelector('[data-k="percent"]').textContent=j.percent+'%';}}catch(e){}},3000);</script>{% endblock %}
