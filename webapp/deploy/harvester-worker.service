[Unit]
Description=Revenue Inbox Harvester queue worker
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/harvester/webapp
EnvironmentFile=/root/harvester/webapp/.env
ExecStart=/root/harvester/.venv/bin/python -u worker.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
