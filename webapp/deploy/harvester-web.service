[Unit]
Description=Revenue Inbox Harvester web application
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/harvester/webapp
EnvironmentFile=/root/harvester/webapp/.env
ExecStart=/root/harvester/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8080 --timeout 120 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
