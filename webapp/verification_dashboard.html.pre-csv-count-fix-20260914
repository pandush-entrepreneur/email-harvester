{% extends "base.html" %}
{% block content %}
<section class="hero"><div><div class="eyebrow">VERIFICATION</div><h1>Keep only deliverable emails.</h1><p>Upload an existing list, automatically detect its email column, and export only rows MailTester accepts.</p></div><a href="{{ url_for('new_verification') }}" class="button">+ Verify a CSV</a></section>
<section class="metric-grid"><article><span>MailTester key</span><strong>{{ 'Available' if key.available else 'In use' }}</strong><small>{{ 'Ready for verification' if key.available else key.workflow + ': ' + key.name }}</small></article><article><span>Output policy</span><strong>Accepted only</strong><small>Rejected and uncertain rows excluded</small></article><article><span>Original data</span><strong>Preserved</strong><small>All source columns retained</small></article></section>
<section class="section-head"><div><h2>Verification jobs</h2><p>Jobs wait safely if the shared key is occupied.</p></div></section><div class="jobs">{% for job in jobs %}<a class="job-card" href="{{ url_for('verification_detail', job_id=job.id) }}"><div class="job-top"><div><h3>{{ job.name }}</h3><span class="muted">{{ job.created_at[:10] }}</span></div><span class="status {{ job.state }}">{{ job.state }}</span></div><div class="progress"><i style="width:{{ job.percent }}%"></i></div><div class="job-stats three"><div><strong>{{ job.percent }}%</strong><span>progress</span></div><div><strong>{{ "{:,}".format(job.accepted) }}</strong><span>accepted rows</span></div><div><strong>{{ "{:,}".format(job.unique_emails) }}</strong><span>unique emails</span></div></div></a>{% else %}<div class="empty"><h3>No verification jobs yet</h3><p>Upload a CSV to clean your first list.</p></div>{% endfor %}</div>
{% endblock %}
